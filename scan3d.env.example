# 3DScan local settings. `scripts/bootstrap.sh` copies this to scan3d.env, which git ignores.
# Every line here is commented out, and the value shown is the default.
#
# Format: KEY=VALUE. The value is the rest of the line: no inline comments and no $VARIABLE
# expansion. Quotes are optional. A real environment variable overrides this file.
# Set SCAN3D_CONFIG to read a different file instead of this one.
# This file can hold a password, so keep it private: chmod 600 scan3d.env

## Server
#SCAN3D_HOST=127.0.0.1
#SCAN3D_PORT=9010
# If you reach it under another name, through a VPN or a reverse proxy, add that name here.
#SCAN3D_ALLOWED_HOSTS=127.0.0.1,localhost
# Sign-in, off or password. Left unset, it is off when SCAN3D_HOST and SCAN3D_ALLOWED_HOSTS are all
# loopback and password otherwise. off is refused on any other address. A proxy that rewrites Host
# to loopback hides the published name, so set password here. Create the first account with
# scan3d users add NAME --admin
#SCAN3D_AUTH=

## Storage. Use absolute paths.
# The case library. It will hold patient images, so put it on suitably protected storage.
#SCAN3D_DATA_DIR=/path/to/3DScan/data
# Folders the server may import from by path, separated by ":". Browser upload needs no entry.
#SCAN3D_IMPORT_ROOTS=/path/to/3DScan

## Imaging
# MRI is implemented but experimental. Add MR to offer it.
#SCAN3D_MODALITIES=CT

## AI compute
# auto: the discrete GPU with the most memory that this PyTorch build sees, otherwise the CPU.
# A build sees only its vendor's GPUs, so auto never chooses between AMD and NVIDIA.
# gpu or gpu:N: require a GPU and fail if there is none. cpu: always the CPU.
#SCAN3D_DEVICE=auto
# Added inference paths, one proof file each, written by scripts/check_gpu.py --path. That file
# is the whole registration: moving it out of this folder removes the path.
#SCAN3D_INFERENCE_PATH_DIR=/path/to/3DScan/.runtime/inference-paths
# TotalSegmentator's weights, license and settings.
#TOTALSEG_HOME_DIR=/path/to/3DScan/.runtime/totalsegmentator
# The nnInteractive model folder.
#SCAN3D_NNINTERACTIVE_MODEL=/path/to/3DScan/.runtime/nninteractive/nnInteractive_v1.0
# Pinned nnU-Net models such as MRSegmentator.
#SCAN3D_SEGMENTATION_MODELS=/path/to/3DScan/.runtime/segmentation-models
# Native mesh and post-processing threads.
#SCAN3D_MESH_THREADS=16
#SCAN3D_POSTPROCESS_WORKERS=4
# The DICOM converter, if it is not .tools/bin/dcm2niix or on PATH.
#SCAN3D_DCM2NIIX=/usr/bin/dcm2niix

## Orthanc (optional). Leave SCAN3D_ORTHANC_URL unset to turn the integration off.
# The address the 3DScan server uses to reach Orthanc's REST API.
#SCAN3D_ORTHANC_URL=http://127.0.0.1:8042
#SCAN3D_ORTHANC_USERNAME=
#SCAN3D_ORTHANC_PASSWORD=
# Orthanc modality identifiers offered for DICOM SEG export, separated by commas.
#SCAN3D_ORTHANC_EXPORT_DESTINATIONS=
# A PEM file for an Orthanc whose HTTPS certificate comes from a private CA.
#SCAN3D_ORTHANC_CA_BUNDLE=/etc/ssl/private-ca.pem

## DICOMweb archive (optional). Leave SCAN3D_DICOMWEB_URL unset to turn it off. See docs/ARCHIVES.md.
#SCAN3D_DICOMWEB_URL=https://pacs.example.test/dicom-web
#SCAN3D_DICOMWEB_NAME="Hospital PACS"
# A stable name for the archive in case records. Set it before the first import.
#SCAN3D_DICOMWEB_ID=hospital-pacs
# none, basic (USERNAME and PASSWORD) or bearer (TOKEN_FILE).
#SCAN3D_DICOMWEB_AUTH=none
#SCAN3D_DICOMWEB_TOKEN_FILE=/etc/scan3d/pacs.token
#SCAN3D_DICOMWEB_QUIET_SECONDS=60

## Direct DICOM sends (optional). Leave SCAN3D_DICOM_DESTINATIONS_FILE unset to turn them off.
# A JSON list of C-STORE destinations; docs/CONFIGURATION.md shows the format.
#SCAN3D_DICOM_DESTINATIONS_FILE=/etc/scan3d/dicom-destinations.json
#SCAN3D_DICOM_AE_TITLE=SCAN3D
