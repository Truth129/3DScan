[Unit]
Description=3DScan incoming DICOM archive
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/3DScan/.runtime/orthanc-incoming
ExecStart=%h/Projects/3DScan/.runtime/orthanc-incoming/bin/Orthanc-1.13.0 %h/Projects/3DScan/.runtime/orthanc-incoming/orthanc.json --logfile=%h/Projects/3DScan/.runtime/orthanc-incoming/orthanc.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
