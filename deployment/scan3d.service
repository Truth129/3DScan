# systemd user unit. docs/INSTALL.md shows how to install it for your checkout path;
# settings come from scan3d.env, which the app reads itself.
[Unit]
Description=3DScan
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/3DScan
ExecStart=%h/3DScan/.venv/bin/scan3d serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
